{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vite BFF",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--configLoader", "runner"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "VITE_CJS_TRACE": "true"
      }
    }
  ]
}
